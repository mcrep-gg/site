# Postgres connection for production. Not needed in development: `npm run dev` starts a
# local PGlite database (stored in .data/pglite) and sets it for you.
# DATABASE_URL=postgres://user:password@host:5432/mcrep

# Shared secret the Link Server sends as "Authorization: Bearer <secret>" to POST /api/link-codes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LINK_SERVER_SECRET=

# The address shown on the sign-in page.
LINK_SERVER_ADDRESS=link.mcrep.gg
